# Charis Christian Center Console — environment variables
# Copy to .env.local for local development.
# Set the same keys in the Vercel project settings for production.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to "true" only for local demos. Never enable in production.
VITE_ENABLE_DEMO_LOGIN=false
